{
  "name": "@jameslnewell/configs",
  "private": true,
  "version": "2.0.2",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@jameslnewell/prettier-config": "workspace:*",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.5",
    "husky": "^7.0.2",
    "prettier": "^3.9.9",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0"
  },
  "prettier": "@jameslnewell/prettier-config",
  "scripts": {
    "build": "pnpm -r --no-sort run build",
    "typing:check": "pnpm -r --no-sort run typing:check",
    "linting:check": "pnpm -r --no-sort run linting:check",
    "linting:fix": "pnpm -r --no-sort run linting:fix",
    "formatting:check": "pnpm -r --no-sort run formatting:check",
    "formatting:fix": "pnpm -r --no-sort run formatting:fix",
    "test": "pnpm -r --no-sort run test",
    "release": "changeset publish"
  },
  "license": "MIT"
}
